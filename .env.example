# ============================================================
# AdventureWorks SQL Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control!
# ============================================================

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ---- Database mode ----
# "sqlite" for local dev, "azure" for production
DB_MODE=sqlite

# ---- SQLite (local dev only) ----
SQLITE_DB_PATH=adventureworks.db

# ---- Azure SQL (production) ----
# In Azure, these come from Key Vault via Managed Identity
SQL_SERVER_FQDN=<your-server>.database.windows.net
SQL_DATABASE_NAME=AdventureWorks
SQL_ADMIN_USERNAME=<username>
SQL_ADMIN_PASSWORD=<password>

# ---- Azure Key Vault (production) ----
KEY_VAULT_URI=https://<your-keyvault>.vault.azure.net/

# ---- App ----
LOG_LEVEL=INFO
APP_PORT=8000
